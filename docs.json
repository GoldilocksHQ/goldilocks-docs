{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "Goldilocks",
  "description": "AI-powered people search platform. Find and connect with the right people using intelligent search and enrichment.",
  "colors": {
    "primary": "#B09A32",
    "light": "#B09A32",
    "dark": "#173652"
  },
  "background": {
    "color": {
      "light": "#FCFCFD",
      "dark": "#111827"
    }
  },
  "favicon": "/favicon.ico",
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "python", "javascript"],
      "defaults": "required"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "api-reference/introduction",
          "api-reference/quickstart"
        ]
      },
      {
        "group": "Endpoints",
        "pages": [
          {
            "group": "Searches",
            "pages": [
              "api-reference/searches/query",
              "api-reference/searches/profiles",
              "api-reference/searches/more-profiles"
            ]
          },
          "api-reference/enrichment",
          "api-reference/jobs"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/goldilocks_logo.png",
    "dark": "/logo/goldilocks_logo.png",
    "href": "/"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:chris@goldilocksai.co.uk"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://www.goldilocksai.co.uk"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "website": "https://www.goldilocksai.co.uk"
    }
  }
}
